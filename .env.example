# Optional: PostgreSQL connection string (resilient JSON storage fallback used if omitted or unreachable)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pichyydoc?schema=public"

# Admin Access PIN (6-digit numeric PIN, change in production)
ADMIN_PIN="123456"

# Session Secret (change in production)
SESSION_SECRET="pichyy-doc-session-secret-key-change-in-production"

# Environment Mode
NODE_ENV="development"
